+  EXPECT_CALL(delegate, OnActivationChanged(true)).Times(0);
+  task_environment_.RunUntilIdle();
+
+  EXPECT_FALSE(window->IsActive());
+  EXPECT_EQ(manager_->GetCurrentKeyboardFocusedWindow(), nullptr);
