+TEST_P(WaylandEmbeddedWindowTest, NoKeyboardLeavesNoStaleFocusBehind) {
+  const gfx::AcceleratedWidget parent = RegisterForeignParent();
+  ASSERT_FALSE(connection_->IsKeyboardAvailable());
