+void WaylandSurface::ApplyFifoConstraint() {
+  if (!connection_->fifo_manager()) {
+    return;
+  }
+  if (!fifo_) {
+    fifo_.reset(wp_fifo_manager_v1_get_fifo(connection_->fifo_manager(),
+                                            surface_.get()));
+    LOG(INFO) << "Wayland FIFO enabled on surface " << get_surface_id();
+  }
+  // The previous buffer must pass a latching deadline before this update can
+  // become active. Keep frame callbacks as the independent throttle required
+  // when the compositor ignores FIFO (occluded or synchronized subsurfaces).
+  wp_fifo_v1_wait_barrier(fifo_.get());
+  wp_fifo_v1_set_barrier(fifo_.get());
+  TRACE_EVENT_INSTANT("wayland", "Wavebench.FifoConstraint", "surface_id",
+                      get_surface_id());
+}
